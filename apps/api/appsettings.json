{
  "Authentication": {
    "Authority": "",
    "Audience": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Security": {
    "RateLimiting": {
      "PermitLimit": 120,
      "WindowMinutes": 1
    }
  },
  "SamGov": {
    "BaseUrl": "https://api.sam.gov",
    "TimeoutSeconds": 10,
    "MaxRetries": 2,
    "RateLimitPerMinute": 60
  },
  "LocalDependencies": {
    "Enabled": false
  },
  "MalwareScanning": {
    "Enabled": true,
    "Provider": "ClamAV",
    "Host": "",
    "Port": 3310,
    "TimeoutSeconds": 30,
    "MaxChunkSizeBytes": 8192
  },
  "InvitationDelivery": {
    "Enabled": false,
    "Provider": "AzureCommunicationServices",
    "PublicWebBaseUrl": "",
    "Endpoint": "",
    "ConnectionString": "",
    "UseManagedIdentity": true,
    "SenderAddress": "",
    "PollIntervalSeconds": 5,
    "LeaseMinutes": 5,
    "MaximumAttempts": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
