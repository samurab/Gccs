    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Security": {
    "RateLimiting": {
      "PermitLimit": 120,
      "WindowMinutes": 1
    },
    "DemoRequestRateLimiting": {
      "PermitLimit": 5,
      "WindowMinutes": 10
    }
  },
  "TaskSearch": {
    "CursorSigningKey": "",
    "PreviousCursorSigningKey": ""
  },
  "SamGov": {
    "BaseUrl": "https://api.sam.gov",
    "TimeoutSeconds": 10,
    "MaxRetries": 2,
    "RateLimitPerMinute": 60
  },
  "LocalDependencies": {
    "Enabled": false
  },
  "MalwareScanning": {
    "Enabled": true,
    "Provider": "ClamAV",
    "Host": "",
    "Port": 3310,
    "TimeoutSeconds": 30,
    "MaxChunkSizeBytes": 8192
  },
  "InvitationDelivery": {
    "Enabled": false,
    "Provider": "AzureCommunicationServices",
    "PublicWebBaseUrl": "",
    "Endpoint": "",
    "ConnectionString": "",
    "UseManagedIdentity": true,
    "SenderAddress": "",
    "PollIntervalSeconds": 5,
    "LeaseMinutes": 5,
    "MaximumAttempts": 5
  },
  "DemoRequests": {
    "Enabled": false,
    "Provider": "AzureCommunicationServices",
    "Endpoint": "",
    "ConnectionString": "",
    "UseManagedIdentity": true,
    "SenderAddress": "",
    "RecipientAddress": "",
    "PublicWebBaseUrl": "",
    "FollowUpTokenSigningKey": "",
    "FollowUpTokenLifetimeHours": 72,
    "PollIntervalSeconds": 5,
    "LeaseMinutes": 5,
    "MaximumAttempts": 5,
    "RetentionDays": 365,
    "HubSpot": {
      "Enabled": false,
      "BaseUrl": "https://api.hubapi.com",
      "PrivateAppToken": ""
    }
  },
  "ExtractionProcessing": {
    "Enabled": true,
    "PollIntervalSeconds": 2,
    "LeaseMinutes": 10,
    "MaximumAttempts": 3
  },
  "AiOutputRetentionProcessing": {
    "Enabled": true,
    "RetentionDays": 365
  },
  "ReportExportProcessing": {
    "Enabled": true,
    "PollIntervalSeconds": 2,
    "LeaseMinutes": 10,
    "MaximumAttempts": 3
  },
  "DueDateReminderProcessing": {
    "Enabled": true,
    "PollIntervalMinutes": 60,
    "LeadTimeDays": 14,
    "BatchSize": 200
  },
  "ReportPdf": {
    "FontDirectory": ""
  },
  "PortalReview": {
    "WatermarkDownloads": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Warning",
        "Gccs.Api.TaskCompatibilityTelemetry": "Information"
      }
    }
