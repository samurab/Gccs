{
  "ConnectionStrings": {
    "GccsDatabase": "Host=localhost;Port=15432;Database=gccs;Username=gccs;Password=gccs_dev_password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000"
    ]
  },
  "LocalDependencies": {
    "Enabled": true,
    "SeedData": {
      "Enabled": true
    },
    "Redis": {
      "ConnectionString": "localhost:16379"
    },
    "ObjectStorage": {
      "Endpoint": "http://localhost:19000",
      "Bucket": "gccs-evidence-dev",
      "AccessKey": "gccs",
      "SecretKey": "gccs_dev_password"
    },
    "MalwareScanner": {
      "Host": "localhost",
      "Port": 13310
    }
  },
  "MalwareScanning": {
    "Enabled": true,
    "Provider": "ClamAV",
    "Host": "localhost",
    "Port": 13310,
    "TimeoutSeconds": 30,
    "MaxChunkSizeBytes": 8192
  },
  "InvitationDelivery": {
    "Enabled": false,
    "Provider": "AzureCommunicationServices",
    "PublicWebBaseUrl": "http://127.0.0.1:5173",
    "Endpoint": "",
    "ConnectionString": "",
    "UseManagedIdentity": true,
    "SenderAddress": "",
    "PollIntervalSeconds": 5,
    "LeaseMinutes": 5,
    "MaximumAttempts": 5
  },
  "Security": {
    "DevelopmentTesting": {
      "Enabled": true
    },
    "DevelopmentAuth": {
      "Enabled": true,
      "DefaultTenantId": "11111111-1111-1111-1111-111111111111",
      "DefaultUserId": "22222222-2222-2222-2222-222222222222",
      "DefaultEmail": "developer@gccs.local",
      "DefaultPlatformPermissions": "ProvisionTenants"
    },
    "RateLimiting": {
      "PermitLimit": 1200,
      "WindowMinutes": 1
    }
  }
}
