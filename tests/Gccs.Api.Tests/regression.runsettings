<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <!-- Test hosts use fixed fixtures; avoid macOS file-watcher reload storms. -->
      <DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE>false</DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE>
    </EnvironmentVariables>
    <!-- GitHub-hosted runners need more than 30 minutes for the complete suite. -->
    <TestSessionTimeout>3600000</TestSessionTimeout>
  </RunConfiguration>
  <xUnit>
    <MaxParallelThreads>4</MaxParallelThreads>
  </xUnit>
</RunSettings>
