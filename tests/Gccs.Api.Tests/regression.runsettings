<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <!-- Test hosts use fixed fixtures; avoid macOS file-watcher reload storms. -->
      <DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE>false</DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE>
    </EnvironmentVariables>
    <!-- Each CI shard has a bounded session; local complete regressions retain headroom. -->
    <TestSessionTimeout>5400000</TestSessionTimeout>
  </RunConfiguration>
  <xUnit>
    <MaxParallelThreads>4</MaxParallelThreads>
  </xUnit>
</RunSettings>
